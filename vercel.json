{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/shopping-study-vercel/index.html"
    },
    {
      "source": "/shopping-study",
      "destination": "/shopping-study-vercel/index.html"
    },
    {
      "source": "/shopping-study/",
      "destination": "/shopping-study-vercel/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "functions": {
    "api/queue-collector.js": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "shopping-events",
          "retryAfterSeconds": 15,
          "initialDelaySeconds": 0
        }
      ]
    }
  }
}
